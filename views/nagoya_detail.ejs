<!Doctype html>
<html>
<head>

  <link rel="stylesheet" href="/public/style.css">

  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>
  <table class="detail">
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>観光地名</td><td><%= data.name %></td></tr>
    <tr><td>住所</td><td><%= data.address %></td></tr>
    <tr><td>紹介文</td><td><%= data.summary %></td></tr>
    <tr><td>特徴</td><td><%= data.point %></td></tr>
  </table>
  <a href="/nagoya/edit/<%= index %>">編集</a>
  <a href="/nagoya">一覧に戻る</a>
</body>
</html>

