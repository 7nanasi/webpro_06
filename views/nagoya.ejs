<!Doctype html>
<html>
<head>

  <link rel="stylesheet" href="/public/style.css">

  <meta charset="utf-8">
  <title>名古屋観光地リスト</title>
</head>
<body>
  <h2>名古屋のおすすめ観光地</h2>

  <table class="list">

    <tr><th>ID</th><th>観光地名</th><th>住所</th><th>削除</th></tr>
    <% let number = 0 %>
    <% for( let row of data ) { %>
      <tr><td><%= row.id %></td>
      <td><a href="/nagoya/<%= number %>"><%= row.name %></a></td>
      <td><%= row.address %></td>

      <td><a href="/nagoya/delete/<%= number %>" onclick="return confirm('本当に削除しますか？');">削除</a></td></tr>

      <% number += 1 %>
    <% } %>
  </table>
  <a href="/nagoya/create">追加</a>
</body>
</html>

