<!Doctype html>
<html>
<head>
  <link rel="stylesheet" href="/public/style.css">
  <meta charset="utf-8">
  <title>ワンピースストーリーリスト</title>
</head>
<body>
  <h2>ワンピース ストーリー</h2>
  <table class="list">
    <tr><th>ID</th><th>編名</th><th>収録話数</th><th>削除</th></tr>
    <% let number = 0 %>
    <% for( let row of data ) { %>
      <tr><td><%= row.id %></td>
      <td><a href="/onepiece/<%= number %>"><%= row.name %></a></td>
      <td><%= row.episodes %></td>
      <td><a href="/onepiece/delete/<%= number %>" onclick="return confirm('本当に削除しますか？');">削除</a></td></tr>
      <% number += 1 %>
    <% } %>
  </table>
  <a href="/onepiece/create">新規追加</a>
</body>
</html>

